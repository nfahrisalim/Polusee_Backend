# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Secrets & local configuration
#   .streamlit/config.toml IS tracked (it holds the PoluSee theme);
#   only secrets must stay out of the repo.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ---------------------------------------------------------------------------
# Model weights
#   ~40 MB each and regenerated by training, so they are distributed
#   out-of-band instead of being committed. See "Model weights" in README.md.
# ---------------------------------------------------------------------------
*.pt
*.pth
*.onnx
*.engine
*.tflite

# Ultralytics training / prediction output
runs/
wandb/
*.yaml.bak

# ---------------------------------------------------------------------------
# Runtime data produced by the app
# ---------------------------------------------------------------------------
# SQLite volume history (written by CameraWorker, read by server.py).
# WAL journal mode also creates the -wal / -shm sidecar files.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Captured CCTV clips
recordings/
*.mp4
*.mov
*.avi
*.mkv

# Logs
*.log
logs/

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo
*~
